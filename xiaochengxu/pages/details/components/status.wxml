<view class="status-card data-v-ce7f4d56"><view class="status-card__copy data-v-ce7f4d56"><text class="status-card__title data-v-ce7f4d56">{{$root.m0}}</text><block wx:if="{{timeout&&status===1}}"><text class="status-card__hint data-v-ce7f4d56">订单已超时</text></block><block wx:else><block wx:if="{{status===1}}"><text class="status-card__hint data-v-ce7f4d56">{{'请在 '+rocallTime+' 内完成支付'}}</text></block><block wx:else><block wx:if="{{status===7}}"><text class="status-card__hint data-v-ce7f4d56">{{''+cancellationReason+''}}</text></block></block></block></view><block wx:if="{{showActions}}"><view class="status-actions data-v-ce7f4d56"><block wx:if="{{canCancel}}"><button data-event-opts="{{[['tap',[['handleCancel',['center','$0'],['orderDetailsData']]]]]}}" class="status-action status-action--secondary data-v-ce7f4d56" bindtap="__e">取消订单</button></block><block wx:if="{{$root.m1}}"><button data-event-opts="{{[['tap',[['handlePay',['$0'],['orderDetailsData.id']]]]]}}" class="status-action status-action--primary data-v-ce7f4d56" bindtap="__e">继续支付</button></block><block wx:if="{{$root.m2}}"><button data-event-opts="{{[['tap',[['handleReminder',['center','$0'],['orderDetailsData.id']]]]]}}" class="status-action status-action--primary data-v-ce7f4d56" bindtap="__e">催单</button></block><block wx:if="{{canRefund}}"><button data-event-opts="{{[['tap',[['handleRefund',['center']]]]]}}" class="status-action status-action--danger data-v-ce7f4d56" bindtap="__e">申请退款</button></block><block wx:if="{{$root.m3}}"><button data-event-opts="{{[['tap',[['oneMoreOrder',['$0'],['orderDetailsData.id']]]]]}}" class="status-action status-action--primary data-v-ce7f4d56" bindtap="__e">再来一单</button></block></view></block></view>