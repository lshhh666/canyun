.spec-sheet.data-v-92d6e38c {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  max-height: 78vh;
  padding: 12rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  overflow: hidden;
  background: #ffffff;
  border-radius: 16rpx 16rpx 0 0;
  box-sizing: border-box;
}
.sheet-handle.data-v-92d6e38c {
  width: 72rpx;
  height: 6rpx;
  margin: 0 auto 18rpx;
  background: #d9e0e8;
  border-radius: 3rpx;
}
.sheet-header.data-v-92d6e38c,
.sheet-footer.data-v-92d6e38c {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.sheet-title.data-v-92d6e38c {
  color: #12263f;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 48rpx;
}
.sheet-subtitle.data-v-92d6e38c {
  color: #748396;
  font-size: 24rpx;
  line-height: 36rpx;
}
.sheet-close.data-v-92d6e38c {
  width: 56rpx;
  color: #647489;
  font-size: 46rpx;
  line-height: 56rpx;
  text-align: center;
}
.spec-list.data-v-92d6e38c {
  max-height: 50vh;
  margin-top: 16rpx;
}
.spec-group.data-v-92d6e38c {
  padding: 18rpx 0 8rpx;
}
.spec-name.data-v-92d6e38c {
  color: #12263f;
  font-size: 27rpx;
  font-weight: 600;
  line-height: 40rpx;
}
.spec-options.data-v-92d6e38c {
  display: flex;
  margin: 4rpx -8rpx 0;
  flex-wrap: wrap;
}
.spec-option.data-v-92d6e38c {
  min-width: 112rpx;
  margin: 12rpx 8rpx;
  padding: 0 22rpx;
  color: #526377;
  background: #ffffff;
  border: 1rpx solid #cbd5df;
  border-radius: 8rpx;
  font-size: 25rpx;
  line-height: 64rpx;
  text-align: center;
  box-sizing: border-box;
}
.spec-option.selected.data-v-92d6e38c {
  color: #147ee8;
  background: #eef6ff;
  border-color: #147ee8;
}
.sheet-footer.data-v-92d6e38c {
  min-height: 96rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #e8edf2;
}
.spec-price.data-v-92d6e38c {
  color: #12263f;
  font-size: 40rpx;
  font-weight: 600;
}
.spec-price text.data-v-92d6e38c {
  font-size: 24rpx;
}
.primary-action.data-v-92d6e38c {
  min-width: 204rpx;
  padding: 0 28rpx;
  color: #ffffff;
  background: #147ee8;
  border-radius: 8rpx;
  font-size: 27rpx;
  line-height: 72rpx;
  text-align: center;
  box-sizing: border-box;
}
