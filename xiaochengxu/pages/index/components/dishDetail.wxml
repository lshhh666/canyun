<view class="dish-sheet data-v-0142b43e"><view class="sheet-handle data-v-0142b43e"></view><view class="sheet-header data-v-0142b43e"><view class="data-v-0142b43e"><view class="sheet-title data-v-0142b43e">{{dishDetailes.name}}</view><view class="sheet-subtitle data-v-0142b43e">{{dishDetailes.type==1?'菜品详情':'套餐内容'}}</view></view><view class="sheet-close data-v-0142b43e" aria-label="关闭" data-event-opts="{{[['tap',[['dishClose',['$event']]]]]}}" bindtap="__e">×</view></view><scroll-view class="sheet-content data-v-0142b43e" scroll-y="true"><block wx:if="{{dishDetailes.type==1}}"><image class="detail-image data-v-0142b43e" mode="aspectFill" src="{{dishDetailes.image}}"></image><block wx:if="{{dishDetailes.description}}"><view class="detail-desc data-v-0142b43e">{{dishDetailes.description}}</view></block></block><block wx:else><view class="meal-list data-v-0142b43e"><block wx:for="{{dishMealData}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view class="meal-item data-v-0142b43e"><image class="meal-image data-v-0142b43e" src="{{item.image}}" mode="aspectFill"></image><view class="meal-info data-v-0142b43e"><view class="meal-name data-v-0142b43e">{{item.name+''}}<text class="data-v-0142b43e">{{"×"+item.copies}}</text></view><view class="meal-desc data-v-0142b43e">{{item.description}}</view></view></view></block></view></block></scroll-view><view class="sheet-footer data-v-0142b43e"><view class="detail-price data-v-0142b43e"><text class="data-v-0142b43e">￥</text>{{displayPrice}}</view><block wx:if="{{hasNoFlavors&&dishDetailes.dishNumber>0}}"><view class="quantity-control data-v-0142b43e"><view data-event-opts="{{[['tap',[['redDishAction',['$0','普通'],['dishDetailes']]]]]}}" class="quantity-button quantity-button--minus data-v-0142b43e" bindtap="__e">−</view><text class="dish-number data-v-0142b43e">{{dishDetailes.dishNumber}}</text><view data-event-opts="{{[['tap',[['addDishAction',['$0','普通'],['dishDetailes']]]]]}}" class="quantity-button quantity-button--add data-v-0142b43e" bindtap="__e">＋</view></view></block><block wx:else><block wx:if="{{!hasNoFlavors}}"><view data-event-opts="{{[['tap',[['moreNormDataesHandle',['$0'],['dishDetailes']]]]]}}" class="primary-action data-v-0142b43e" bindtap="__e"> 选择规格 </view></block><block wx:else><view data-event-opts="{{[['tap',[['addDishAction',['$0','普通'],['dishDetailes']]]]]}}" class="primary-action data-v-0142b43e" bindtap="__e">加入购物车</view></block></block></view></view>