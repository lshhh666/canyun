<view data-event-opts="{{[['tap',[['',['$event']]]]]}}" class="cart-sheet data-v-b2da6f24" catchtap="__e"><view class="sheet-handle data-v-b2da6f24"></view><view class="sheet-header data-v-b2da6f24"><view class="data-v-b2da6f24"><view class="sheet-title data-v-b2da6f24">购物车</view><view class="sheet-subtitle data-v-b2da6f24">已选商品可继续调整数量</view></view><view data-event-opts="{{[['tap',[['clearCardOrder']]]]}}" class="clear-action data-v-b2da6f24" catchtap="__e">清空购物车</view></view><scroll-view class="cart-list data-v-b2da6f24" scroll-y="true"><block wx:for="{{orderAndUserInfo}}" wx:for-item="item" wx:for-index="ind" wx:key="ind"><view class="cart-group data-v-b2da6f24"><block wx:for="{{item.dishList}}" wx:for-item="obj" wx:for-index="index" wx:key="index"><view class="cart-item data-v-b2da6f24"><image class="dish-image data-v-b2da6f24" mode="aspectFill" src="{{obj.image}}"></image><view class="dish-info data-v-b2da6f24"><view class="dish-name data-v-b2da6f24">{{obj.name}}</view><block wx:if="{{obj.dishFlavor}}"><view class="dish-flavor data-v-b2da6f24">{{obj.dishFlavor}}</view></block><view class="dish-row data-v-b2da6f24"><view class="dish-price data-v-b2da6f24"><text class="data-v-b2da6f24">￥</text>{{obj.amount}}</view><view class="quantity-control data-v-b2da6f24"><block wx:if="{{obj.number&&obj.number>0}}"><view data-event-opts="{{[['tap',[['redDishAction',['$0','购物车'],[[['orderAndUserInfo','',ind],['dishList','',index]]]]]]]}}" class="quantity-button quantity-button--minus data-v-b2da6f24" catchtap="__e"> − </view></block><block wx:if="{{obj.number&&obj.number>0}}"><text class="dish-number data-v-b2da6f24">{{obj.number}}</text></block><view data-event-opts="{{[['tap',[['addDishAction',['$0','购物车'],[[['orderAndUserInfo','',ind],['dishList','',index]]]]]]]}}" class="quantity-button quantity-button--add data-v-b2da6f24" catchtap="__e"> ＋ </view></view></view></view></view></block></view></block><view class="list-space data-v-b2da6f24"></view></scroll-view></view>
