.profile-editor.data-v-447f6324 {
  position: fixed;
  z-index: 1000;
  inset: 0;
  display: flex;
  align-items: flex-end;
}
.profile-editor__mask.data-v-447f6324 {
  position: absolute;
  inset: 0;
  background: rgba(18, 38, 63, 0.42);
}
.profile-editor__sheet.data-v-447f6324 {
  position: relative;
  width: 100%;
  padding: 36rpx 32rpx calc(28rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-radius: 28rpx 28rpx 0 0;
  box-sizing: border-box;
  box-shadow: 0 12rpx 32rpx rgba(18, 38, 63, 0.12);
}
.profile-editor__header.data-v-447f6324 {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}
.profile-editor__title.data-v-447f6324,
.profile-editor__description.data-v-447f6324 {
  display: block;
}
.profile-editor__title.data-v-447f6324 {
  color: #12263f;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 48rpx;
}
.profile-editor__description.data-v-447f6324 {
  margin-top: 6rpx;
  color: #60758d;
  font-size: 24rpx;
  line-height: 36rpx;
}
.profile-editor__close.data-v-447f6324 {
  width: 64rpx;
  height: 64rpx;
  margin: -12rpx -12rpx 0 16rpx;
  padding: 0;
